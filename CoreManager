local currentMouseTask = nil
local VirtualInputManager = game:GetService("VirtualInputManager")
local mouse = LocalPlayer:GetMouse()
local ForceSenseHopOnBossFarmLogin = false

local function moveMouseToGui(guiObject)
    local thisTask = coroutine.running()

    if currentMouseTask and coroutine.status(currentMouseTask) == "running" then
        print("[Mouse] Cancelling previous mouse task.")
        task.cancel(currentMouseTask)
    end
    currentMouseTask = thisTask

    pcall(function()
        local step = 40
        task.wait(0.1) 
        if State.IsPanicMode then return end 

        local targetX, targetY
        if typeof(guiObject) == "Vector2" then
            targetX = guiObject.X
            targetY = guiObject.Y
        else
            if not (guiObject and guiObject.AbsolutePosition and guiObject.AbsoluteSize) then
                 print("[Mouse] Invalid GUIObject passed to moveMouseToGui")
                 return
            end
            local pos = guiObject.AbsolutePosition
            local size = guiObject.AbsoluteSize
            targetX = pos.X + size.X / 2
            targetY = pos.Y + size.Y / 2
        end
        
        while math.abs(mouse.X - targetX) > 1 or math.abs(mouse.Y - targetY) > 1 do
            if State.IsPanicMode then
                print("[Mouse] Panic mode activated, stopping mouse task.")
                break
            end
            if typeof(guiObject) ~= "Vector2" and not (guiObject and guiObject.Parent) then
                print("[Mouse] GUIObject disappeared, stopping move.")
                break
            end
            local dx = math.clamp(targetX - mouse.X, -step, step)
            local dy = math.clamp(targetY - mouse.Y, -step, step)
            if mousemoverel then mousemoverel(dx, dy) end
            task.wait(0.01)
        end
        
        if not State.IsPanicMode then
            if typeof(guiObject) ~= "Vector2" and not (guiObject and guiObject.Parent) then return end
            local tX, tY
            if typeof(guiObject) == "Vector2" then
                tX = guiObject.X
                tY = guiObject.Y
            else
                if not (guiObject and guiObject.AbsolutePosition and guiObject.AbsoluteSize) then return end
                local pos = guiObject.AbsolutePosition
                local size = guiObject.AbsoluteSize
                tX = pos.X + size.X / 2
                tY = pos.Y + size.Y / 2
            end

            local finalDX = tX - mouse.X
            local finalDY = tY - mouse.Y
            if (finalDX ~= 0 or finalDY ~= 0) and mousemoverel then 
                mousemoverel(finalDX, finalDY) 
            end
        end
    end)
    if currentMouseTask == thisTask then currentMouseTask = nil end
end

