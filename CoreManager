local function writeHopMarker(context)
    if not writefile then
        warn("[PuppyHub] writefile unavailable. Hop marker not written for " .. tostring(context))
        return false
    end

    local payload = tostring(tick()) .. "|" .. tostring(game.PlaceId) .. "|" .. tostring(game.JobId) .. "|" .. tostring(context or "unknown")
    for attempt = 1, 3 do
        local ok = pcall(function()
            writefile(HOP_MARKER_FILE, payload)
        end)
        if ok and isfile and isfile(HOP_MARKER_FILE) then
            return true
        end
        task.wait(0.05)
    end

    warn("[PuppyHub] Failed to verify hop marker write for " .. tostring(context))
    return false
end

local function deleteHopMarker(context)
    if not delfile then
        return false
    end

    for attempt = 1, 3 do
        local ok = pcall(function()
            if isfile and isfile(HOP_MARKER_FILE) then
                delfile(HOP_MARKER_FILE)
            end
        end)
        if ok and (not isfile or not isfile(HOP_MARKER_FILE)) then
            return true
        end
        task.wait(0.05)
    end

    warn("[PuppyHub] Failed to delete hop marker for " .. tostring(context))
    return false
end

