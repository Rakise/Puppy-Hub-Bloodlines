-- CombatTags live at ReplicatedStorage.CombatTags[PlayerName]
-- ============================================================================
local function isInCombat()
    local combatFolder = ReplicatedStorage:FindFirstChild("CombatTags")
    if not combatFolder then return false end
    local myTags = combatFolder:FindFirstChild(game.Players.LocalPlayer.Name)
    if not myTags then return false end
    return #myTags:GetChildren() > 0
end

-- ============================================================================
-- VIRTUAL MOUSE SYSTEM
-- Uses VIM + GuiInset to properly simulate mouse input at GUI element positions.
-- GuiInset is the TopBar offset that shifts all AbsolutePosition values.
-- ============================================================================
local VirtualMouse = {}

function VirtualMouse.applyInset(x, y)
    local inset = GuiService:GetGuiInset()
    return x + inset.X, y + inset.Y
end

function VirtualMouse.move(x, y)
    if not VirtualInputManager then return false end
    local rx, ry = VirtualMouse.applyInset(x, y)
    VirtualInputManager:SendMouseMoveEvent(rx, ry, game)
    return true
end

function VirtualMouse.click(x, y, button)
    if not VirtualInputManager then return false end
    button = button or 0 -- 0 = left, 1 = right
    local rx, ry = VirtualMouse.applyInset(x, y)
    VirtualInputManager:SendMouseButtonEvent(rx, ry, button, true, game, 0)
    task.wait()
    VirtualInputManager:SendMouseButtonEvent(rx, ry, button, false, game, 0)
    return true
end

-- Move to position + click (full sequence for GUI buttons)
function VirtualMouse.clickAt(x, y, button)
    if not VirtualInputManager then return false end
    VirtualMouse.move(x, y)
    task.wait(0.15)
    VirtualMouse.click(x, y, button)
    return true
end

-- Click at the center of a GUI element
function VirtualMouse.clickGui(guiObject, button)
    if not VirtualInputManager or not guiObject then return false end
    local pos = guiObject.AbsolutePosition
    local size = guiObject.AbsoluteSize
    local centerX = pos.X + size.X / 2
    local centerY = pos.Y + size.Y / 2
    print("[VirtualMouse] Clicking GUI at (" .. math.floor(centerX) .. ", " .. math.floor(centerY) .. ")")
    return VirtualMouse.clickAt(centerX, centerY, button)
end

