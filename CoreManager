-- ============================================================================
-- ANTICHEAT INTERCEPTOR & REMOTE HOOK
-- Blocks: BanMe, KickMe, FlagMe (always)
-- Blocks: voidDamage, InflictFire (when Prevent Void enabled)
-- ============================================================================
local DataEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("DataEvent")
local DataFunction = ReplicatedStorage:WaitForChild("Events"):WaitForChild("DataFunction")

-- Forward-declared; State table is defined later but the hook closure captures the reference
local _preventVoidCheck = false -- updated by State.PreventVoidEnabled toggle

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if not checkcaller() and method == "FireServer" and self == DataEvent then
        local action = args[1]
        -- Always block anticheat punishment remotes
        if action == "BanMe" or action == "KickMe" or action == "FlagMe" then
            warn("[PuppyHub] Anticheat blocked:", action, args[2])
            return
        end
        -- Block void/lava damage remotes when Prevent Void is enabled
        if _preventVoidCheck and (action == "voidDamage" or action == "InflictFire") then
            return
        end
    end
    return oldNamecall(self, ...)
end))
print("[PuppyHub] Anticheat interceptor injected.")

