local currentMouseTask = nil
local VirtualInputManager = game:GetService("VirtualInputManager")
local mouse = LocalPlayer:GetMouse()

local function moveMouseToGui(guiObject)
    local thisTask = coroutine.running()

    if currentMouseTask and coroutine.status(currentMouseTask) == "running" then
        print("[Mouse] Cancelling previous mouse task.")
        task.cancel(currentMouseTask)
    end
    currentMouseTask = thisTask

    pcall(function()
        local step = 40
        task.wait(0.1) 
        if State.IsPanicMode then return end 

        local targetX, targetY
        if typeof(guiObject) == "Vector2" then
            targetX = guiObject.X
            targetY = guiObject.Y
        else
            if not (guiObject and guiObject.AbsolutePosition and guiObject.AbsoluteSize) then
                 print("[Mouse] Invalid GUIObject passed to moveMouseToGui")
                 return
            end
            local pos = guiObject.AbsolutePosition
            local size = guiObject.AbsoluteSize
            targetX = pos.X + size.X / 2
            targetY = pos.Y + size.Y / 2
        end
        
        while math.abs(mouse.X - targetX) > 1 or math.abs(mouse.Y - targetY) > 1 do
            if State.IsPanicMode then
                print("[Mouse] Panic mode activated, stopping mouse task.")
                break
            end
            if typeof(guiObject) ~= "Vector2" and not (guiObject and guiObject.Parent) then
                print("[Mouse] GUIObject disappeared, stopping move.")
                break
            end
            local dx = math.clamp(targetX - mouse.X, -step, step)
            local dy = math.clamp(targetY - mouse.Y, -step, step)
            if mousemoverel then mousemoverel(dx, dy) end
            task.wait(0.01)
        end
        
        if not State.IsPanicMode then
            if typeof(guiObject) ~= "Vector2" and not (guiObject and guiObject.Parent) then return end
            local tX, tY
            if typeof(guiObject) == "Vector2" then
                tX = guiObject.X
                tY = guiObject.Y
            else
                if not (guiObject and guiObject.AbsolutePosition and guiObject.AbsoluteSize) then return end
                local pos = guiObject.AbsolutePosition
                local size = guiObject.AbsoluteSize
                tX = pos.X + size.X / 2
                tY = pos.Y + size.Y / 2
            end

            local finalDX = tX - mouse.X
            local finalDY = tY - mouse.Y
            if (finalDX ~= 0 or finalDY ~= 0) and mousemoverel then 
                mousemoverel(finalDX, finalDY) 
            end
        end
    end)
    if currentMouseTask == thisTask then currentMouseTask = nil end
end

local function clickMouse()
    if mouse1press and mouse1release then
        mouse1press()
        task.wait(0.05)
        mouse1release()
    elseif VirtualInputManager then
        VirtualInputManager:SendMouseButtonEvent(mouse.X, mouse.Y, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(mouse.X, mouse.Y, 0, false, game, 0)
    end
end

local function tweenForcefieldCFrameSync(root, targetCFrame, duration)
    local startTime = tick()
    local startCFrame = root.CFrame
    while (tick() - startTime) < duration do
        if AutoFarmHandler and AutoFarmHandler.checkSafety then
            local safe, reason = AutoFarmHandler.checkSafety()
            if not safe then
                if Config.ServerHopOnDanger and AutoFarmHandler.executeServerHop then
                    print("[PuppyHub] ⚠️ Unsafe during forcefield tween: " .. tostring(reason) .. ". Hopping...")
                    AutoFarmHandler.executeServerHop()
                    return false
                else
                    print("[PuppyHub] ⚠️ Unsafe: " .. tostring(reason) .. " but hopping is disabled.")
                end
            end
        end
        local alpha = TweenService:GetValue((tick() - startTime) / duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        task.wait()
    end
    root.CFrame = targetCFrame
    return true
end

local function RemoveForcefield()
    print("[PuppyHub] Removing Forcefield Sequence Initiated...")
    
    if AutoFarmHandler and AutoFarmHandler.emergencyStop then
        AutoFarmHandler.emergencyStop()
    end
    
    StopMovementLoops()

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local forwardPos = root.CFrame * CFrame.new(0, 0, -40)
        local originalPos = root.CFrame
        
        local safe = tweenForcefieldCFrameSync(root, forwardPos, 0.5)
        if not safe then return end
        
        task.wait(0.3)
        
        if AutoFarmHandler and AutoFarmHandler.checkSafety then
            local stillSafe, r = AutoFarmHandler.checkSafety()
            if not stillSafe and Config.ServerHopOnDanger and AutoFarmHandler.executeServerHop then
                AutoFarmHandler.executeServerHop()
                return
            end
        end
        
        safe = tweenForcefieldCFrameSync(root, originalPos, 0.5)
        if not safe then return end
        print("[PuppyHub] Forcefield removed. Resume operations.")
    end

    StartMovementLoops()
end

local function AutoLoginRoutine()
    print("[PuppyHub] Starting Auto-Login Routine...")
    local clientGui = PlayerGui:WaitForChild("ClientGui", 30)
    if not clientGui then return end
    
    local menuScreen = clientGui:WaitForChild("MenuScreen", 10)
    if menuScreen then
        local loadingScreen = menuScreen:WaitForChild("LoadingScreen", 10)
        if loadingScreen then
            repeat task.wait(0.5) until loadingScreen.BackgroundTransparency >= 0.9 or not loadingScreen.Visible
        end
        local menuFrame = menuScreen:WaitForChild("Menu", 5)
        if menuFrame then
            local continueBtn = menuFrame:FindFirstChild("Continue")
            if continueBtn and continueBtn:IsA("ImageButton") then
                task.wait(1)
                print("[PuppyHub] Moving physical mouse to Continue button...")
                moveMouseToGui(continueBtn)
                task.wait(0.1)
                clickMouse()
                print("[PuppyHub] Continue clicked!")
            end
        end
    end
    
    task.wait(7)
    
    if AutoFarmHandler and AutoFarmHandler.checkSafety then
        local safe, reason = AutoFarmHandler.checkSafety()
        if not safe then
            if Config.ServerHopOnDanger then
                print("[PuppyHub] ⚠️ Unsafe: " .. tostring(reason) .. ". Hopping...")
                if AutoFarmHandler.executeServerHop then AutoFarmHandler.executeServerHop() return end
            else
                print("[PuppyHub] ⚠️ Unsafe: " .. tostring(reason) .. ". Server Hop disabled, staying.")
            end
        end
    end
    
    RemoveForcefield()
    
    if Config.AutoSummon and AutoFarmHandler then
        print("[PuppyHub] Resuming Auto Farm...")
        if Config.AutoPickup then AutoFarmHandler.Settings.AutoPickup = true end
        
        -- Sync settings
        AutoFarmHandler.Settings.ServerHopOnDanger = Config.ServerHopOnDanger
        AutoFarmHandler.Settings.ServerHopOnChakraSense = Config.ServerHopOnChakraSense

        
        AutoFarmHandler.toggleSummon(true)
    end
    
    -- Auto-resume Boss Farm after server hop
    if BossFarm and (Config.BossFarmEnabled or Config.BossLoopEnabled) then
        print("[PuppyHub] Resuming Boss Farm...")
        -- Restore all settings
        BossFarm.Settings.SelectedBosses = Config.BossSelectedBosses or {}
        BossFarm.Settings.ServerHopIfNoBoss = Config.BossServerHopIfNoBoss
        BossFarm.Settings.ServerHopIfChakraSense = Config.BossServerHopIfChakraSense
        BossFarm.Settings.HopAfterLoop = Config.BossHopAfterLoop
        BossFarm.Settings.AutoLootOnKill = Config.BossAutoLootOnKill
        
        task.wait(2) -- Let game fully load
        
        if Config.BossLoopEnabled then
            print("[PuppyHub] Starting Advanced Boss Loop...")
            BossFarm.startLoop()
        elseif Config.BossFarmEnabled then
            print("[PuppyHub] Starting Single Boss Farm...")
            BossFarm.Settings.Enabled = true
            BossFarm.start()
        end
    end
end

LoadConfig()
if AutoFarmHandler then
