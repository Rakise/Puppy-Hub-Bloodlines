local function detectChakraSenseDanger()
    local settingsFolder = ReplicatedStorage:FindFirstChild("Settings")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if settingsFolder then
                local pSettings = settingsFolder:FindFirstChild(player.Name)
                if pSettings then
                    local sVal = pSettings:FindFirstChild("CurrentSkill")
                    if sVal and type(sVal.Value) == "string" and string.find(string.lower(sVal.Value), "sense") then
                        return true, "Chakra Sense (" .. player.Name .. ")"
                    end
                end
            end

            if player.Character then
                for _, tool in ipairs(player.Character:GetChildren()) do
                    if tool:IsA("Tool") and string.find(string.lower(tool.Name), "sense") then
                        return true, "Chakra Sense Tool (" .. player.Name .. ")"
                    end
                end
            end

            local backpack = player:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, tool in ipairs(backpack:GetChildren()) do
                    if tool:IsA("Tool") and string.find(string.lower(tool.Name), "sense") then
                        return true, "Chakra Sense Tool (" .. player.Name .. ")"
                    end
                end
            end
        end
    end

    return false, nil
end

-- Checks if login/tween safety is unsafe.
local function isChakraSenseDuringForcefield()
    if ForceSenseHopOnBossFarmLogin then
        local foundSense, senseReason = detectChakraSenseDanger()
        if foundSense then
            return true, senseReason
        end
    end

    if not AutoFarmHandler or not AutoFarmHandler.checkSafety then return false end
    local safe, reason = AutoFarmHandler.checkSafety()
    return not safe, reason
end

local function hopImmediatelyForLoginDanger(reason)
    print("[PuppyHub] Unsafe during login: " .. tostring(reason) .. ". Hopping instantly with no reposition.")

    if AutoFarmHandler and AutoFarmHandler.emergencyStop then
        AutoFarmHandler.emergencyStop()
    end
    StopMovementLoops()

    if AutoFarmHandler and AutoFarmHandler.executeServerHop then
        AutoFarmHandler.executeServerHop()
        return true
    end

    warn("[PuppyHub] AutoFarmHandler.executeServerHop unavailable during login danger.")
    return false
end

-- Waits until chakra sense / danger clears, or hops if configured
-- Returns false if we hopped (caller should abort), true if safe to continue
local function waitForSafety(root, instantHop)
    local unsafeStart = tick()
    while true do
        local unsafe, reason = isChakraSenseDuringForcefield()
        if not unsafe then return true end

        if instantHop then
            hopImmediatelyForLoginDanger(reason)
            return false
        end

        if tick() - unsafeStart > 15 and Config.ServerHopOnDanger and AutoFarmHandler and AutoFarmHandler.executeServerHop then
            print("[PuppyHub] Danger persisted 15s during forcefield: " .. tostring(reason) .. ". Hopping...")
            AutoFarmHandler.executeServerHop()
            return false
        end

        task.wait(0.5)
    end
end

local function waitForAutoLoginContinue(menuScreen, timeoutSeconds)
    local deadline = tick() + (timeoutSeconds or 30)
    local menu = menuScreen and menuScreen:FindFirstChild("Menu")
    local continueButton = menu and menu:FindFirstChild("Continue")
    local newGameButton = menu and menu:FindFirstChild("NewGame")

    if not menu or not continueButton then
        warn("[PuppyHub] Auto-login could not find the menu continue gate.")
        return nil
    end

    while tick() < deadline do
        local loadingScreen = menuScreen:FindFirstChild("LoadingScreen")
        local loadingDone = not loadingScreen
            or not loadingScreen.Visible
            or loadingScreen.BackgroundTransparency >= 0.9
        local menuReady = menu.Visible and menu.AbsoluteSize.X > 0 and menu.AbsoluteSize.Y > 0

        if loadingDone and menuReady and continueButton.Visible then
            return "Continue"
        end

        if loadingDone and newGameButton and newGameButton.Visible then
            warn("[PuppyHub] Auto-login reached menu but only NewGame is visible.")
            return nil
        end

        task.wait(0.1)
    end

    warn("[PuppyHub] Timed out waiting for Continue button during auto-login.")
    return nil
end

local function tweenForcefieldCFrameSync(root, targetCFrame, duration)
    local startTime = tick()
    local startCFrame = root.CFrame
    while (tick() - startTime) < duration do
        -- Check for danger during tween
        local unsafe, reason = isChakraSenseDuringForcefield()
        if unsafe then
            -- Pause the tween: do not tween back, just freeze and wait
            print("[PuppyHub] Danger during tween: " .. tostring(reason) .. ". Pausing...")
            local canContinue = waitForSafety(root, false)
            if not canContinue then return false end
            -- Reset tween timing from current position
            print("[PuppyHub] Danger cleared, resuming tween...")
            startTime = tick() - (tick() - startTime) -- Preserve elapsed progress
            startCFrame = root.CFrame
        end
        local alpha = TweenService:GetValue((tick() - startTime) / duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        task.wait()
    end
    root.CFrame = targetCFrame
    return true
end

local function RemoveForcefield()
    print("[PuppyHub] Removing Forcefield Sequence Initiated...")
    
    -- Pre-check: wait for safety before even starting
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- If danger is found BEFORE we start removing forcefield, hop INSTANTLY
    local canStart = waitForSafety(root, true)
    if not canStart then return end
    
    if AutoFarmHandler and AutoFarmHandler.emergencyStop then
        AutoFarmHandler.emergencyStop()
    end
    
    StopMovementLoops()

    local forwardPos = root.CFrame * CFrame.new(0, 0, -40)
    local originalPos = root.CFrame
    
    local safe = tweenForcefieldCFrameSync(root, forwardPos, 0.5)
    if not safe then return end
    
    task.wait(0.3)
    
    -- Check again between tweens (not instant hop here, pause instead)
    local canContinue = waitForSafety(root, false)
    if not canContinue then return end
    
    safe = tweenForcefieldCFrameSync(root, originalPos, 0.5)
    if not safe then return end
    print("[PuppyHub] Forcefield removed. Resume operations.")

    StartMovementLoops()
end

local function AutoLoginRoutine()
    print("[PuppyHub] Starting Auto-Login Routine...")
    local clientGui = PlayerGui:WaitForChild("ClientGui", 30)
    if not clientGui then return end
    
    local menuScreen = clientGui:WaitForChild("MenuScreen", 10)
    if menuScreen then
        local loadingScreen = menuScreen:WaitForChild("LoadingScreen", 10)
        if loadingScreen then
            repeat task.wait(0.5) until loadingScreen.BackgroundTransparency >= 0.9 or not loadingScreen.Visible
        end

        local autoLoginGate = waitForAutoLoginContinue(menuScreen, 30)
        if autoLoginGate ~= "Continue" then
            warn("[PuppyHub] Auto-login aborted before Continue became available.")
            return
        end
        
        -- ============================================================
        -- NATIVE LoadIntoGame REPLICATION
        -- Mirrors the decompiled function without needing VIM clicks
        -- ============================================================
        task.wait(0.25)
        print("[PuppyHub] Replicating native LoadIntoGame sequence...")
        
        -- Step 1: Hide menu frames
        pcall(function()
            local menuSelect = menuScreen:FindFirstChild("MenuSelect")
            if menuSelect then menuSelect.Visible = false end
        end)
        pcall(function()
            local menu = menuScreen:FindFirstChild("Menu")
            if menu then menu.Visible = false end
        end)
        pcall(function()
            local serverList = menuScreen:FindFirstChild("ServerList") or clientGui:FindFirstChild("ServerList")
            if serverList then serverList.Visible = false end
        end)
        
        -- Step 2: Invoke the server to register us as loaded in
        local loadResult = nil
        pcall(function()
            loadResult = DataFunction:InvokeServer("LoadedIn")
        end)
        print("[PuppyHub] LoadedIn result:", tostring(loadResult))
        
        -- Step 3: Stop menu music (find and stop any playing sounds in menu)
        pcall(function()
            for _, desc in ipairs(menuScreen:GetDescendants()) do
                if desc:IsA("Sound") and desc.IsPlaying then
                    desc:Stop()
                end
            end
        end)
        
        -- Step 4: Enable the ServerList GuiHandler if it exists
        pcall(function()
            local sl = clientGui:FindFirstChild("ServerList")
            if sl then
                local handler = sl:FindFirstChild("GuiHandler")
                if handler and handler:IsA("LocalScript") then
                    handler.Disabled = false
                end
            end
        end)
        
        task.wait(0.5)
        
        -- Step 5: Hide the menu screen entirely
        pcall(function()
            menuScreen.Visible = false
        end)
        
        -- Step 6: Reset camera to gameplay mode
        pcall(function()
            local cam = Workspace.CurrentCamera
            cam.CameraType = Enum.CameraType.Custom
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    cam.CameraSubject = hum
                end
            end
        end)
        
        print("[PuppyHub] Native LoadIntoGame complete!")
        task.wait(1)
    end
    
    task.wait(7)

    if shouldConsumeHopMarker and isMainBloodlinesPlace then
        deleteHopMarker("AutoLoginRoutine")
        shouldConsumeHopMarker = false
    end
    
    if AutoFarmHandler and AutoFarmHandler.checkSafety then
        local safe, reason = AutoFarmHandler.checkSafety()
        if not safe then
            hopImmediatelyForLoginDanger(reason)
            return
        end
    end
    
    RemoveForcefield()
    
    if Config.AutoSummon and AutoFarmHandler then
        print("[PuppyHub] Resuming Auto Farm...")
        if Config.AutoPickup then AutoFarmHandler.Settings.AutoPickup = true end
        
        -- Sync settings
        AutoFarmHandler.Settings.ServerHopOnDanger = Config.ServerHopOnDanger
        AutoFarmHandler.Settings.ServerHopOnChakraSense = Config.ServerHopOnChakraSense

        
        AutoFarmHandler.toggleSummon(true)
    end
    
    -- Auto-resume Boss Farm after server hop
    if BossFarm and (Config.BossFarmEnabled or Config.BossLoopEnabled) then
        print("[PuppyHub] Resuming Boss Farm...")
        -- Restore all settings
        BossFarm.Settings.SelectedBosses = Config.BossSelectedBosses or {}
        BossFarm.Settings.ServerHopIfNoBoss = Config.BossServerHopIfNoBoss
        BossFarm.Settings.ServerHopIfChakraSense = Config.BossServerHopIfChakraSense
        BossFarm.Settings.HideThenHopOnThreat = Config.BossHideThenHopOnThreat
        BossFarm.Settings.HopAfterLoop = Config.BossHopAfterLoop
        BossFarm.Settings.AutoLootOnKill = Config.BossAutoLootOnKill
        BossFarm.Settings.AutoSellTrinkets = Config.BossAutoSellTrinkets
        BossFarm.Settings.AutoSellGems = Config.BossAutoSellGems
        BossFarm.Settings.AutoSellFruits = Config.BossAutoSellFruits
        BossFarm.Settings.WebhookURL = Config.BossWebhookURL or ""
        
        task.wait(2) -- Let game fully load
        
        if Config.BossLoopEnabled then
            print("[PuppyHub] Starting Advanced Boss Loop...")
            BossFarm.startLoop()
        elseif Config.BossFarmEnabled then
            print("[PuppyHub] Starting Single Boss Farm...")
            BossFarm.Settings.Enabled = true
            BossFarm.start()
        end
    end
    
    -- Restore Visual/Misc toggles after server hop
    task.spawn(function()
        task.wait(1) -- Let modules initialize
        print("[PuppyHub] Restoring visual settings...")
        if Config.PlayerESP and PlayerESPHandler then pcall(function() PlayerESPHandler:enable() end) end
        if Config.ObserveUI and ObserveUI then pcall(function() ObserveUI:enable() end) end
        if Config.ChatLogs and ChatLog then pcall(function() ChatLog:enable() end) end
        if Config.MobESP and MobESPHandler then pcall(function() MobESPHandler:toggleMobs(true) end) end
        if Config.NpcESP and MobESPHandler then pcall(function() MobESPHandler:toggleNPCs(true) end) end
        if Config.TrinketESP and ItemESPHandler then pcall(function() ItemESPHandler:toggleCategory("Trinket", true) end) end
        if Config.FruitESP and ItemESPHandler then pcall(function() ItemESPHandler:toggleCategory("Fruit", true) end) end
        if Config.GemESP and ItemESPHandler then pcall(function() ItemESPHandler:toggleCategory("Gem", true) end) end
        if Config.ChakraESP and ChakraESPHandler then pcall(function() ChakraESPHandler:enable() end) end
        if Config.CorruptedESP and CorruptedESPHandler then pcall(function() CorruptedESPHandler:enable() end) end
        if Config.TransTrail and TransTrail then pcall(function() TransTrail:enable() end) end
        if Config.NoFog and NoFog then pcall(function() NoFog:enable() end) end
        print("[PuppyHub] Visual settings restored!")
    end)
end

