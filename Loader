-- ============================================================================
-- Puppy Hub | Bloodlines Loader (Fixed)
-- ============================================================================

local ScriptURL = "https://ghproxy.net/https://raw.githubusercontent.com/Rakise/Puppy-Hub-Bloodlines/refs/heads/main/CoreManager"
local LoaderURL = "https://ghproxy.net/https://raw.githubusercontent.com/Rakise/Puppy-Hub-Bloodlines/refs/heads/main/Loader"

-- Show loading notification safely
pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Puppy Hub 🐾",
        Text = "Loading... Please wait.",
        Duration = 5,
    })
end)

local function waitForGame()
    -- 1. Wait for game to load entirely
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    
    local Players = game:GetService("Players")
    
    -- 2. Safely wait for LocalPlayer (Crucial for auto-execute)
    while not Players.LocalPlayer do
        task.wait(0.1)
    end
    local player = Players.LocalPlayer
    
    -- 3. Fix the Character race condition
    local character = player.Character or player.CharacterAdded:Wait()
    
    -- 4. Wait for PlayerGui
    player:WaitForChild("PlayerGui", 30)
    
    -- 5. Wait for ReplicatedStorage events
    local RS = game:GetService("ReplicatedStorage")
    local events = RS:WaitForChild("Events", 30)
    
    if not events then
        warn("[PuppyHub] ReplicatedStorage.Events took too long to load!")
        -- We don't return false here just in case the game doesn't actually need it right away
    end
    
    -- 6. Breather for rendering
    task.wait(2)
    return true
end

-- Main execution
task.spawn(function()
    local ready = waitForGame()
    if not ready then return end
    
    -- Load the hub
    local success, err = pcall(function()
        loadstring(game:HttpGet(ScriptURL))()
    end)
    
    if not success then
        warn("[PuppyHub] Failed to load CoreManager: " .. tostring(err))
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Puppy Hub ❌",
                Text = "Load failed! Check console.",
                Duration = 10,
            })
        end)
        return
    end
    
    print("[PuppyHub] ✅ Loaded successfully!")
end)

-- Queue on Teleport (Also fixed for race conditions)
local queueFunction = queue_on_teleport or queueonteleport
if queueFunction then
    local teleportScript = [[
        task.spawn(function()
            if not game:IsLoaded() then
                game.Loaded:Wait()
            end
            
            local Players = game:GetService("Players")
            while not Players.LocalPlayer do task.wait(0.1) end
            local player = Players.LocalPlayer
            
            local character = player.Character or player.CharacterAdded:Wait()
            
            pcall(function()
                loadstring(game:HttpGet("]] .. LoaderURL .. [["))()
            end)
        end)
    ]]
    
    queueFunction(teleportScript)
end
