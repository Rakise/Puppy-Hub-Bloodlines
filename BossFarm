    if State.detectedWeapon and not string.find(string.lower(State.detectedWeapon), "fist") then
        State.weaponHeightBoost = val
    end
end
BossFarm.teleportToSafeSpot = function()
    local spot = Safety.getSafeSpot() or Vector3.new(-3933, 1120, -4571)
    local pData = Utils.getPlayerData()
    if pData then
        pData.rootPart.CFrame = CFrame.new(spot + Vector3.new(0, 3, 0))
        Utils.notify("Teleported to Safe Spot!", 3)
    end
end

return BossFarm
