function Farm.farmBoss(hum, model, bossName)
    local pData = Utils.getPlayerData()
    if not pData then return end
    local config = BOSS_CONFIGS[bossName]
    if not config then return end
    
    -- *** PRE-ENGAGEMENT SAFETY CHECK ***
    -- Check if anyone is near the boss BEFORE teleporting to it
    -- This prevents the suspicious "teleport to boss feet → immediately flee" pattern
    local contested, nearPlayer = Safety.isBossContested(model, BossFarm.Settings.PlayerDetectionRadius)
    if contested then
        Utils.log("Pre-engagement: Players near " .. bossName .. " (" .. tostring(nearPlayer) .. "), aborting!")
        if BossFarm.Settings.ServerHopIfChakraSense then
            Safety.evacuateAndHop("Players near " .. bossName .. " (pre-engage: " .. tostring(nearPlayer) .. ")")
        else
            Safety.evacuateAndHide("Players near " .. bossName .. " (pre-engage: " .. tostring(nearPlayer) .. ")")
        end
        return
    end
    
    -- Check chakra sense before engaging
    local senseActive, sensePlayer = Safety.isChakraSenseActive()
    if senseActive then
        Utils.log("Pre-engagement: Chakra Sense active (" .. tostring(sensePlayer) .. "), aborting!")
        if BossFarm.Settings.ServerHopIfChakraSense then
            Safety.evacuateAndHop("Chakra Sense (pre-engage: " .. tostring(sensePlayer) .. ")")
        else
            Safety.evacuateAndHide("Chakra Sense (pre-engage: " .. tostring(sensePlayer) .. ")")
        end
        return
    end
    
    State.currentBoss = bossName
    State.currentModel = model
    State.currentHumanoid = hum
    State.healthThreshold = pData.humanoid.MaxHealth * 0.15
    State.bossDeathDetected = false
    State.isLooting = false
    
    -- Detect and equip weapon
    Weapons.updateBoost()
    
    -- Setup per-boss animation monitors
    AnimMonitors.setup(model, bossName, config)
    
    -- Monitor knocked state for auto-grip
    Knocked.monitor(model)
    
    -- Start charging for bonus damage
    task.wait(0.5)
    Charging.start()
    
    Utils.notify("Farming: " .. bossName, 3)
    
    -- Start noclip, positioning, and attacking
    Combat.enableNoclip()
    Positioning.startAnchoring(model, config)
    Combat.startAttacking(model)
    
    -- Health + safety monitor loop
    local lastPlayerCheck = tick()
    local lastChakraCheck = tick()
    while State.running and not State.evacuating and State.currentBoss == bossName do
        local cPData = Utils.getPlayerData()
        if not cPData then break end
        
        -- Check if boss died (either directly or via anchor flag from Kamui/model destruction)
        local bossDead = State.bossDeathDetected
            or not hum or not hum.Parent or hum.Health <= 0
            or not model or not model.Parent
        
        if bossDead then
            -- Stop combat systems first
            Farm.stopCurrent()
            Webhook.send("💀 Boss Killed", "**" .. bossName .. "** has been defeated!", 3066993)
            
            -- Loot collection: set flag to prevent anchor from repositioning us
            if BossFarm.Settings.AutoLootOnKill and config.lootSpot then
                State.isLooting = true
                Utils.log("Boss died, teleporting to loot spot for " .. bossName)
                Loot.collectNearBoss(bossName, config)
                State.isLooting = false
            end
            break
        end
        
        -- Health threshold check — wait for full regen before continuing
        if cPData.humanoid.Health < State.healthThreshold then
            Utils.notify("Health low! Retreating to regen...", 3)
            Farm.stopCurrent()
            
            local safeSpot = Safety.getSafeSpot() or SECRET_SPOT 
            local pd = Utils.getPlayerData()
            if pd then pd.rootPart.CFrame = CFrame.new(safeSpot) end
            
            -- Wait until HP is back to 100% (or farm is stopped)
            Utils.log("Waiting for HP to regen to 100%...")
            while State.running do
                local regenData = Utils.getPlayerData()
                if not regenData then break end
                
                -- Enforce TP if game rubberbands us back to boss due to fake fall damage
                local dist = (regenData.rootPart.Position - safeSpot).Magnitude
                if dist > 30 then
                    regenData.rootPart.CFrame = CFrame.new(safeSpot)
                else
                    -- Walk randomly at safe spot (looks natural if a mod is watching)
                    Utils.randomWalkAt(safeSpot, 6)
                end
                
                if regenData.humanoid.Health >= regenData.humanoid.MaxHealth then
                    Utils.log("HP fully regenerated!")
                    Utils.notify("HP full! Resuming fight...", 2)
                    break
                end
                
                -- Safety checks during regen
                local senseActive, sensePlayer = Safety.isChakraSenseActive()
                if senseActive then
                    if BossFarm.Settings.ServerHopIfChakraSense then
                        Safety.evacuateAndHop("Chakra Sense (" .. sensePlayer .. ") while regen!")
                    else
                        Safety.evacuateAndHide("Chakra Sense (" .. sensePlayer .. ") while regen!")
                    end
                    return
                end
                
                task.wait(math.random(10, 20) / 10) -- Randomized wait looks more natural
            end
            
            -- After regen, DON'T break — re-enter the loop to re-engage the SAME boss
            -- We need to re-find the boss since we cleared state
            if State.running then
                local reHum, reModel = Detection.findBoss(bossName)
                if reHum and reModel then
                    -- Re-setup everything for this boss
                    State.currentBoss = bossName
                    State.currentModel = reModel
                    State.currentHumanoid = reHum
                    State.bossDeathDetected = false
                    hum = reHum
                    model = reModel
                    
                    local newPData = Utils.getPlayerData()
                    if newPData then
                        State.healthThreshold = newPData.humanoid.MaxHealth * 0.5
                    end
                    
                    Weapons.updateBoost()
                    AnimMonitors.setup(model, bossName, config)
                    Knocked.monitor(model)
                    task.wait(0.5)
                    Charging.start()
                    Combat.enableNoclip()
                    Positioning.startAnchoring(model, config)
                    Combat.startAttacking(model)
                    Utils.notify("Re-engaging: " .. bossName, 2)
                else
                    Utils.notify(bossName .. " despawned during regen.", 2)
                    break
                end
            else
                break
            end
            
            -- Continue the while loop to keep fighting
            continue
        end
        
        -- Periodic player proximity check
        if tick() - lastPlayerCheck >= 2 then
            lastPlayerCheck = tick()
            local contested, nearPlayer = Safety.isBossContested(model, BossFarm.Settings.PlayerDetectionRadius)
            if contested then
                if BossFarm.Settings.ServerHopIfChakraSense then
                    Safety.evacuateAndHop("Players nearby! (" .. tostring(nearPlayer) .. ")")
                else
                    Safety.evacuateAndHide("Players nearby! (" .. tostring(nearPlayer) .. ")")
                end
                return
            end
        end
        
        task.wait(BossFarm.Settings.HealthCheckInterval)
    end
end

function Farm.stopCurrent()
    -- Stop attack + positioning
    Charging.stop()
    if State.anchorConn then State.anchorConn:Disconnect(); State.anchorConn = nil end
    if State.attackThread then pcall(task.cancel, State.attackThread); State.attackThread = nil end
    if State.knockedThread then pcall(task.cancel, State.knockedThread); State.knockedThread = nil end
    -- NOTE: Don't cancel dangerMonitorThread here — it's managed by evacuate functions
    
    -- Reset per-boss state
    State.bossHeightBoost = 0
    State.hyugaInVoid = false
    State.hakuSafeSpot = false
    State.weaponHeightBoost = 0
    State.inDanger = false
    State.bossDeathDetected = false
    State.lastGroundTouch = nil
    if State.antiSnipePart then pcall(function() State.antiSnipePart:Destroy() end); State.antiSnipePart = nil end
    -- Don't clear currentBoss here during looting — farmBoss checks it in the while loop
    if not State.isLooting then
        State.currentBoss = nil
        State.currentModel = nil
        State.currentHumanoid = nil
    end
    
    -- Disconnect all event connections and cancel threads
    Utils.disconnectAll()
    Utils.cancelAllThreads()
end

-- ============================================
-- SINGLE BOSS FARM (Original behavior, upgraded)
-- ============================================
function Farm.start()
    if State.running then return end
    State.farmThread = task.spawn(function()
        State.running = true
        State.evacuating = false
        Utils.notify("Boss auto-farm started!", 3)
        
        Safety.startMonitor()
        
        while BossFarm.Settings.Enabled and State.running do
            Farm.stopCurrent()
            
            local hum, model, bossName = Detection.findAnySelectedBoss()
            
            if not hum then
                -- Try triggering spawns for selected bosses
                for name, isSelected in pairs(BossFarm.Settings.SelectedBosses) do
                    if isSelected then
                        local config = BOSS_CONFIGS[name]
                        if config and config.triggerSpawn then
                            Detection.triggerSpawnIfNeeded(name, config)
                            if not State.running then return end
                            hum, model = Detection.findBoss(name)
                            if hum and model then
                                bossName = name
                                break
                            end
                        end
                    end
                end
            end
            
            if not hum then
                if BossFarm.Settings.ServerHopIfNoBoss then
                    Utils.notify("No bosses found! Hopping...", 3)
                    task.wait(2)
                    ServerHop.execute()
                    break
                else
                    task.wait(2)
                    continue
                end
            end
            
            -- Check if boss is contested
            local contested, nearPlayer = Safety.isBossContested(model, BossFarm.Settings.PlayerDetectionRadius)
            if contested then
                Safety.evacuateAndHop("Players nearby! (" .. tostring(nearPlayer) .. ")")
                return
            end
            
            Farm.farmBoss(hum, model, bossName)
            task.wait(1)
        end
        
        State.running = false
    end)
end

function Farm.stop()
    BossFarm.Settings.Enabled = false
    State.running = false
    Farm.stopCurrent()
    if State.farmThread then pcall(task.cancel, State.farmThread) end
    Utils.notify("Auto-farm stopped", 2)
end

-- ============================================
-- ADVANCED BOSS LOOP (Sequential multi-boss cycle)
-- ============================================
local BossLoop = {}

function BossLoop.getSelectedList()
    local list = {}
    for bossName, enabled in pairs(BossFarm.Settings.SelectedBosses) do
        if enabled then table.insert(list, bossName) end
    end
    table.sort(list)
    return list
end

function BossLoop.start()
    if State.bossLoopThread then pcall(task.cancel, State.bossLoopThread) end
    BossFarm.Settings.BossLoopEnabled = true
    State.running = true
    State.evacuating = false
    
    State.bossLoopThread = task.spawn(function()
        Utils.notify("Advanced Boss Loop started!", 3)
        
        Safety.startMonitor()
        
        while BossFarm.Settings.BossLoopEnabled and State.running do
            local loopList = BossLoop.getSelectedList()
            
            if #loopList == 0 then
                Utils.notify("No bosses selected for loop!", 3)
                BossLoop.stop()
                break
            end
            
            -- Determine starting index (for resume after evacuate)
            local startIdx = 1
            if State.bossLoopIndex > 0 and State.bossLoopIndex <= #loopList then
                startIdx = State.bossLoopIndex
                Utils.log("Resuming boss loop from index " .. startIdx .. " (" .. loopList[startIdx] .. ")")
            end
            
            -- Iterate through each selected boss
            -- If resuming from middle, do startIdx..#list, then 1..startIdx-1 to complete full cycle
            local indicesToProcess = {}
            for i = startIdx, #loopList do
                table.insert(indicesToProcess, i)
            end
            if startIdx > 1 then
                -- Wrap around: farm the bosses we skipped at the beginning
                for i = 1, startIdx - 1 do
                    table.insert(indicesToProcess, i)
                end
            end
            
            for _, i in ipairs(indicesToProcess) do
                if not BossFarm.Settings.BossLoopEnabled or not State.running then break end
                
                local bossName = loopList[i]
                State.bossLoopIndex = i  -- Track where we are in the loop
                
                local config = BOSS_CONFIGS[bossName]
                if not config then continue end
                
                -- Wait for boss to spawn (trigger if needed)
                local hum, model
                if config.triggerSpawn then
                    hum, model = Detection.waitForBossSpawn(bossName, config, 16)
                else
                    hum, model = Detection.findBoss(bossName)
                end
                
                if not hum or not model then
                    Utils.notify(bossName .. " unavailable, skipping...", 2)
                    continue
                end
                
                -- Check if contested
                local contested, nearPlayer = Safety.isBossContested(model, BossFarm.Settings.PlayerDetectionRadius)
                if contested then
                    Safety.evacuateAndHop("Players near " .. bossName .. " (" .. tostring(nearPlayer) .. ")")
                    return
                end
                
                -- Farm this boss (farmBoss handles loot collection internally before returning)
                Farm.farmBoss(hum, model, bossName)
                
                -- Clear current boss state after farmBoss finishes (in case looting flag was set)
                State.currentBoss = nil
                State.currentModel = nil
                State.currentHumanoid = nil
                
                -- Give a moment before moving to next boss
                task.wait(2)
            end
            
            -- Full loop complete — reset index for next cycle
            State.bossLoopIndex = 0
            
            -- Auto sell at end of loop
            if BossFarm.Settings.AutoSellTrinkets or BossFarm.Settings.AutoSellGems then
                Utils.log("Loop complete — running auto sell...")
                pcall(function()
                    local dataFunc = GetDataFunction()
                    if not dataFunc then
                        Utils.log("DataFunction not found, skipping sell.")
                        return
                    end
                    
                    if BossFarm.Settings.AutoSellTrinkets then
                        -- Calculate trinket sell value from inventory
                        local trinketValue = 0
                        pcall(function()
                            local gui = LocalPlayer.PlayerGui
                            local clientGui = gui and gui:FindFirstChild("ClientGui")
                            local mainframe = clientGui and clientGui:FindFirstChild("Mainframe")
                            local loadout = mainframe and mainframe:FindFirstChild("Loadout")
                            if not loadout then return end
                            local inv = loadout:FindFirstChild("Inventory")
                            local scroll = inv and inv:FindFirstChild("InventoryScroll")
                            if not scroll then return end
                            for i = 1, 105 do
                                pcall(function()
                                    local slot = scroll:FindFirstChild("InvSlot" .. i)
                                    if not slot then return end
                                    local slotText = slot:FindFirstChild("SlotText")
                                    local itemName = slotText and slotText:IsA("TextLabel") and slotText.Text or ""
                                    local val = TRINKET_VALUES[itemName]
                                    if val then
                                        local qty = 1
                                        pcall(function()
                                            local itemNum = slot:FindFirstChild("ItemNumber")
                                            local numLabel = itemNum and itemNum:FindFirstChild("Number")
                                            if numLabel and numLabel:IsA("TextLabel") and numLabel.Text ~= "" then
                                                local n = numLabel.Text:match("x(%d+)") or numLabel.Text:match("(%d+)")
                                                if n then qty = tonumber(n) or 1 end
                                            end
                                        end)
                                        trinketValue = trinketValue + (val * qty)
                                    end
                                end)
                            end
                        end)
                        if trinketValue > 0 then
                            pcall(function() dataFunc:InvokeServer("SellingBulk", trinketValue, "Trinket") end)
                            Utils.notify("💰 Auto-sold trinkets (" .. trinketValue .. " value)", 3)
                            Webhook.send("💰 Auto Sell", "Bulk sold **Trinkets** (value: " .. trinketValue .. ")", 15844367)
                        end
                    end
                    
                    if BossFarm.Settings.AutoSellGems then
                        -- Calculate gem sell value
                        local gemValue = 0
                        pcall(function()
                            local gui = LocalPlayer.PlayerGui
                            local clientGui = gui and gui:FindFirstChild("ClientGui")
                            local mainframe = clientGui and clientGui:FindFirstChild("Mainframe")
                            local loadout = mainframe and mainframe:FindFirstChild("Loadout")
                            if not loadout then return end
                            local inv = loadout:FindFirstChild("Inventory")
                            local scroll = inv and inv:FindFirstChild("InventoryScroll")
                            if not scroll then return end
                            for i = 1, 105 do
                                pcall(function()
                                    local slot = scroll:FindFirstChild("InvSlot" .. i)
                                    if not slot then return end
                                    local slotText = slot:FindFirstChild("SlotText")
                                    local itemName = slotText and slotText:IsA("TextLabel") and slotText.Text or ""
                                    if GemSet[itemName] then
                                        local qty = 1
                                        pcall(function()
                                            local itemNum = slot:FindFirstChild("ItemNumber")
                                            local numLabel = itemNum and itemNum:FindFirstChild("Number")
                                            if numLabel and numLabel:IsA("TextLabel") and numLabel.Text ~= "" then
                                                local n = numLabel.Text:match("x(%d+)") or numLabel.Text:match("(%d+)")
                                                if n then qty = tonumber(n) or 1 end
                                            end
                                        end)
                                        gemValue = gemValue + (10 * qty)
                                    end
                                end)
                            end
                        end)
                        if gemValue > 0 then
                            pcall(function() dataFunc:InvokeServer("SellingBulk", gemValue, "Gem") end)
                            Utils.notify("💎 Auto-sold gems (" .. gemValue .. " value)", 3)
                            Webhook.send("💎 Auto Sell", "Bulk sold **Gems** (value: " .. gemValue .. ")", 3447003)
                        end
                    end
                end)
                task.wait(1)
            end
            
            -- Full loop complete
            if BossFarm.Settings.BossLoopEnabled and BossFarm.Settings.HopAfterLoop then
                Safety.evacuateAndHop("Loop complete")
                return
            end
            
            task.wait(2)
        end
        
        State.running = false
    end)
end

function BossLoop.stop()
    BossFarm.Settings.BossLoopEnabled = false
    State.running = false
    Farm.stopCurrent()
    if State.bossLoopThread then pcall(task.cancel, State.bossLoopThread); State.bossLoopThread = nil end
    Utils.notify("Boss loop stopped", 2)
end

