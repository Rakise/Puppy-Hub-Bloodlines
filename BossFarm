-- AUTO LOOT
-- ============================================
local Loot = {}

function Loot.getGemCount()
    local count = 0
    pcall(function()
        local dataFunc = GetDataFunction()
        if dataFunc then
            local data = dataFunc:InvokeServer("Profile")
            if data and data.Gems then
                for _ in pairs(data.Gems) do count = count + 1 end
            end
        end
    end)
    -- Fallback: count gems in backpack if remote fails
    if count == 0 then
        pcall(function()
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if GemSet[item.Name] then count = count + 1 end
                end
            end
        end)
    end
    return count
end

function Loot.getTrinketCount()
    local count = 0
    pcall(function()
        local gui = LocalPlayer.PlayerGui
        local clientGui = gui and gui:FindFirstChild("ClientGui")
        local mainframe = clientGui and clientGui:FindFirstChild("Mainframe")
        local loadout = mainframe and mainframe:FindFirstChild("Loadout")
        if not loadout then return end
        
        local inv = loadout:FindFirstChild("Inventory")
        local scroll = inv and inv:FindFirstChild("InventoryScroll")
        if scroll then
            for i = 1, 105 do
                pcall(function()
                    local slot = scroll:FindFirstChild("InvSlot" .. i)
                    if not slot then return end
                    local slotText = slot:FindFirstChild("SlotText")
                    local itemName = slotText and slotText:IsA("TextLabel") and slotText.Text or ""
                    -- Count trinkets (non-gem ones like rings, bracelets, necklaces)
                    if TrinketSet[itemName] and not GemSet[itemName] then
                        count = count + 1
                    end
                end)
            end
        end
    end)
    return count
end

local TRINKET_CAP = 20

function Loot.collectNearBoss(bossName, config)
    local lootSpot = config.lootSpot
    if not lootSpot then return end
    
    local pData = Utils.getPlayerData()
    if not pData then return end
    
    local dataEvent = GetDataEvent()
    if not dataEvent then return end
    
    -- Helper: quick pickup of a single item
    local function pickupItem(entry)
        if not entry.obj.Parent then return true end
        local pd = Utils.getPlayerData()
        if pd then pd.rootPart.CFrame = CFrame.new(entry.pos + Vector3.new(0, 3, 0)) end
        
        -- Spam pickup for up to 0.4s or until item is gone
        local spamEnd = tick() + 0.4
        while tick() < spamEnd do
            if not entry.obj.Parent then return true end
            pcall(function() dataEvent:FireServer("PickUp", entry.id) end)
            task.wait(0.05)
        end
        return not entry.obj.Parent
    end
    
    -- Helper: safety check (inline hide-and-return, does NOT destroy farm state)
    -- Returns true only if we must ABORT looting entirely (e.g. hop triggered)
    local lootAborted = false
    local function checkSafety()
        local senseActive, sensePlayer = Safety.isChakraSenseActive()
        local contested, nearPlayer = Safety.isPlayerNearPosition(lootSpot, BossFarm.Settings.PlayerDetectionRadius)
        
        if not senseActive and not contested then return false end
        
        local reason = senseActive 
            and ("Chakra Sense (" .. (sensePlayer or "?") .. ") while looting")
            or ("Players nearby (" .. (nearPlayer or "?") .. ") while looting")
        
        Utils.notify("Hiding from danger while looting...", 3)
        Utils.log(reason)
        
        -- Teleport to safe spot and wait for danger to clear
        local safeSpot = Safety.getSafeSpot()
        if not safeSpot then
            -- Both safe spots compromised — must hop
            Safety.evacuateAndHop("No safe spot available while looting!")
            lootAborted = true
            return true
        end
        
        local pd = Utils.getPlayerData()
        if pd then Utils.safeTeleport(CFrame.new(safeSpot)) end
        
        -- Wait for danger to clear (max 60s before giving up and hopping)
        local hideStart = tick()
        while tick() - hideStart < 60 do
            local cpd = Utils.getPlayerData()
            if cpd then
                local dist = (cpd.rootPart.Position - safeSpot).Magnitude
                if dist > 30 then cpd.rootPart.CFrame = CFrame.new(safeSpot) end
            end
            
            local stillSense = Safety.isChakraSenseActive()
            local stillContested = Safety.isPlayerNearPosition(lootSpot, BossFarm.Settings.PlayerDetectionRadius)
            if not stillSense and not stillContested then
                break
            end
            
            if tick() - hideStart >= 60 then
                Safety.evacuateAndHop("Danger persisted 60s while looting!")
                lootAborted = true
                return true
            end
            task.wait(2)
        end
        
        -- Coast is clear — return to loot spot
        Utils.notify("Coast clear! Returning to loot...", 3)
        pd = Utils.getPlayerData()
        if pd then Utils.safeTeleport(CFrame.new(lootSpot + Vector3.new(0, 15, 0))) end
        
        -- Wait the 5-10 second respawn cooldown before items become pickable again
        local respawnWait = math.random(8, 10)
        Utils.log("Waiting " .. respawnWait .. "s loot respawn cooldown...")
        for w = 1, respawnWait do
            pd = Utils.getPlayerData()
            if pd then Utils.safeTeleport(CFrame.new(lootSpot + Vector3.new(0, 15, 0))) end
            task.wait(1)
        end
        
        -- Reset seen objects so items can be re-queued after returning
        seenObj = {}
        -- Re-scan workspace for items that are still there
        for _, obj in ipairs(workspace:GetChildren()) do
            queueObj(obj)
            if obj:IsA("Folder") or obj:IsA("Model") then
                for _, child in ipairs(obj:GetChildren()) do queueObj(child) end
            end
        end
        
        return false
    end
    
    Utils.log("Collecting loot for " .. bossName)
    Utils.notify("Collecting loot...", 3)
    
    local gemCount = Loot.getGemCount()
    local trinketCount = Loot.getTrinketCount()
    local skipGems = gemCount >= GEM_CAP
    local skipTrinkets = trinketCount >= TRINKET_CAP
    if skipGems then Utils.log("Gems at cap, skipping gems.") end
    if skipTrinkets then Utils.log("Trinkets at cap, skipping known trinkets.") end
    
    local collectedNames = {}
    local pendingQueue = {}
    local seenObj = {}
    
    local function queueObj(obj)
        if not obj then return end
        -- Accept Models, BaseParts, and also MeshParts that might be standalone loot
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
        if seenObj[obj] then return end
        
        local isGem = GemSet[obj.Name]
        local isTrinket = TrinketSet[obj.Name] and not isGem
        
        -- Cap skipping
        if isGem and skipGems then return end
        -- Unknown/special items (like a wrap) aren't in TrinketSet, so they bypass this skip perfectly
        if isTrinket and skipTrinkets then return end
        
        -- Position: try multiple strategies for weird model structures
        local pos = nil
        if obj:IsA("BasePart") then
            pos = obj.Position
        elseif obj:IsA("Model") then
            -- 1. PrimaryPart
            if obj.PrimaryPart then
                pos = obj.PrimaryPart.Position
            else
                -- 2. Direct child BasePart
                local directPart = obj:FindFirstChildWhichIsA("BasePart")
                if directPart then
                    pos = directPart.Position
                else
                    -- 3. Recursive search — handles nested models (wraps, schematics, etc.)
                    local deepPart = obj:FindFirstChildWhichIsA("BasePart", true)
                    if deepPart then
                        pos = deepPart.Position
                    end
                end
            end
        end
        if not pos then return end
        if (lootSpot - pos).Magnitude > 200 then return end
        
        -- ID lookup: recursive search to find ID anywhere in the hierarchy
        local idVal = obj:FindFirstChild("ID", true) -- recursive=true
        -- Validate it's actually a value type we can use
        if idVal and not (idVal:IsA("NumberValue") or idVal:IsA("IntValue") or idVal:IsA("StringValue")) then
            idVal = nil
        end
        if not idVal then return end
        
        seenObj[obj] = true
        table.insert(pendingQueue, {
            obj = obj, pos = pos, id = idVal.Value,
            name = obj.Name, dist = (lootSpot - pos).Magnitude
        })
    end
    
    -- Initial fast scan across Workspace root
    for _, obj in ipairs(workspace:GetChildren()) do
        queueObj(obj)
        if obj:IsA("Folder") or obj:IsA("Model") then
            for _, child in ipairs(obj:GetChildren()) do queueObj(child) end
        end
    end
    
    -- Setup listeners for loot dropping slightly late
    local conn1 = workspace.ChildAdded:Connect(function(child)
        task.delay(0.2, function() queueObj(child) end)
    end)
    local debris = workspace:FindFirstChild("Debris")
    local conn2 = debris and debris.ChildAdded:Connect(function(child)
        task.delay(0.2, function() queueObj(child) end)
    end)
    
    local startTime = tick()
    local maxWait = 35 -- Max seconds to wait for loot
    local noNewItemTimer = 0
    local MIN_LOOT_WAIT = 15 -- Minimum seconds before allowing no-new-items exit
    
    -- Grace period: wait for fresh loot to spawn before scanning
    -- This prevents stale loot from previous kills triggering a premature exit
    for g = 1, 5 do
        pData = Utils.getPlayerData()
        if pData then
            Utils.safeTeleport(CFrame.new(lootSpot + Vector3.new(0, 15, 0)))
        end
        if checkSafety() then break end
        task.wait(1)
    end
    
    -- Dynamic loop: grab queue, exit when no new items
    while tick() - startTime < maxWait do
        -- Hold position securely overhead to prevent being hit/stuck
        pData = Utils.getPlayerData()
        if pData then
            Utils.safeTeleport(CFrame.new(lootSpot + Vector3.new(0, 15, 0)))
        end
        
        -- Safety check
        if checkSafety() then break end
        
        if #pendingQueue > 0 then
            local toProcess = pendingQueue
            pendingQueue = {}
            table.sort(toProcess, function(a, b) return a.dist < b.dist end)
            
            for _, entry in ipairs(toProcess) do
                if checkSafety() then break end
                if pickupItem(entry) then
                    table.insert(collectedNames, entry.name)
                end
            end
            noNewItemTimer = 0
        else
            noNewItemTimer = noNewItemTimer + 1
        end
        
        -- Exit condition: only after minimum wait has passed
        local elapsed = tick() - startTime
        if elapsed >= MIN_LOOT_WAIT and #collectedNames > 0 and noNewItemTimer >= 5 then
            break
        end
        
        task.wait(1)
    end
    
    if conn1 then conn1:Disconnect() end
    if conn2 then conn2:Disconnect() end
    
    local lootSummary = #collectedNames > 0 and table.concat(collectedNames, ", ") or "None"
    Utils.notify("Boss loot collected! (" .. #collectedNames .. " items)", 3)
    Webhook.send("💰 Loot Collected", "**Boss:** " .. bossName .. "\n**Items (" .. #collectedNames .. "):** " .. lootSummary, 5763719)
end

-- ============================================
-- COMBAT (Dash + Attack)
-- ============================================
local Combat = {}

function Combat.startAttacking(model)
    local currentRunId = State.runId
    State.attackThread = task.spawn(function()
        local dataEvent = GetDataEvent()
        while State.running and State.currentBoss and not State.evacuating and State.runId == currentRunId do
            if State.deathCheckInProgress or State.mode ~= "engaging" or State.hyugaArenaUnsafe or Safety.getForcedPosition() then
                task.wait(0.05)
                continue
            end
            
            local attackPosition = nil
            if model and model.Parent then
                local bossRoot = Utils.getBossRoot(model)
                if bossRoot then
                    attackPosition = bossRoot.Position
                    State.lastBossPosition = attackPosition
                end
            end
            if not attackPosition and tick() < (State.bossDeathAttackUntil or 0) then
                attackPosition = State.lastBossPosition
            end

            if dataEvent and attackPosition then
                pcall(function() dataEvent:FireServer("Dash", "Sub", attackPosition) end)
                task.wait(0.05)
                pcall(function() dataEvent:FireServer("CheckMeleeHit", nil, "NormalAttack", false) end)
            end
            
            task.wait(BossFarm.Settings.AttackInterval)
        end
    end)
    return State.attackThread
end

function Combat.enableNoclip()
    Utils.addConnection(RunService.Stepped:Connect(function()
        if not State.running or State.evacuating then return end
        for i = #State.characterBaseParts, 1, -1 do
            local part = State.characterBaseParts[i]
            if not part or not part.Parent then
                table.remove(State.characterBaseParts, i)
            else
                part.CanCollide = false
            end
        end
    end))
end

