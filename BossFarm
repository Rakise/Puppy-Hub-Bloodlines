function Weapons.updateBoost()
    State.detectedWeapon = Weapons.scanHotbar()
    local wBoost = 0
    if State.detectedWeapon then
        if string.find(string.lower(State.detectedWeapon), "fist") then
            wBoost = -3
        else
            wBoost = BossFarm.Settings.WeaponHeightBoost or 0
        end
    end
    State.weaponHeightBoost = wBoost
    Weapons.equip(State.detectedWeapon)
    if State.detectedWeapon ~= "Fist" then
        Utils.notify("Weapon: " .. State.detectedWeapon, 2)
    end
end

function Farm.farmBoss(hum, model, bossName)
    local pData = Utils.getPlayerData()
    if not pData then return end
    local config = BOSS_CONFIGS[bossName]
    if not config then return end
    
    -- *** PRE-ENGAGEMENT SAFETY CHECK ***
    -- Check if anyone is near the boss BEFORE teleporting to it
    -- This prevents the suspicious "teleport to boss feet → immediately flee" pattern
    local contested, nearPlayer = Safety.isBossContested(model, BossFarm.Settings.PlayerDetectionRadius)
    if contested then
        Utils.log("Pre-engagement: Players near " .. bossName .. " (" .. tostring(nearPlayer) .. "), skipping.")
        Utils.notify("Players near " .. bossName .. ", skipping...", 2)
        return "contested"
    end
    
    -- Check chakra sense before engaging
    local senseActive, sensePlayer = Safety.isChakraSenseActive()
    if senseActive then
        Utils.log("Pre-engagement: Chakra Sense active (" .. tostring(sensePlayer) .. "), aborting!")
        Safety.evacuateAndHide("Chakra Sense (pre-engage: " .. tostring(sensePlayer) .. ")")
        return
    end
    
    State.currentBoss = bossName
    State.currentModel = model
    State.currentHumanoid = hum
    State.healthThreshold = pData.humanoid.MaxHealth * 0.5
    State.bossDeathDetected = false
    State.isLooting = false
    Utils.recordEvent("Boss Start", bossName)
    
    -- Detect and equip weapon
    Weapons.updateBoost()
    
    -- Setup per-boss animation monitors
    AnimMonitors.setup(model, bossName, config)
    Positioning.primeCombatOffsets(model, config)
    
    -- Monitor knocked state for auto-grip
    Knocked.monitor(model)
    
    -- Start charging for bonus damage
    task.wait(0.5)
    Charging.start()
    Utils.setMode("engaging")
    
    Utils.notify("Farming: " .. bossName, 3)
    
    -- Start noclip, positioning, and attacking
    Combat.enableNoclip()
    Positioning.startAnchoring(model, config)
    Combat.startAttacking(model)
    
    -- Health + safety monitor loop
    while State.running and not State.evacuating and State.currentBoss == bossName do
        local cPData = Utils.getPlayerData()
        if not cPData then break end

        if bossName == "Hyuga Boss" and State.hyugaArenaTimeoutRequested then
            Utils.notify("Hyuga left arena too long. Skipping...", 3)
            Farm.stopCurrent()
            return "skipped"
        end
        
        -- Check if boss died (either directly or via anchor flag from Kamui/model destruction)
        local bossDead = State.bossDeathDetected
            or not hum or not hum.Parent or hum.Health <= 0
            or not model or not model.Parent
        
        if bossDead then
            State.bossDeathDetected = true
            Positioning.beginBossDeathHold(config, 1.5)
            Utils.recordEvent("Boss Dead", bossName)

            local holdDeadline = tick() + 1.5
            while State.running and not State.evacuating and tick() < holdDeadline do
                task.wait()
            end
            local preLootSpot = config.lootSpot or State.lastBossPosition
            local shouldAutoLootNow = preLootSpot and (BossFarm.Settings.AutoLootOnKill or BossFarm.Settings.BossLoopEnabled)
            if shouldAutoLootNow then
                State.isLooting = true
                Utils.setMode("looting")
                Utils.log("Boss died, teleporting to loot spot for " .. bossName)

                local pd = Utils.getPlayerData()
                if pd then
                    Utils.safeTeleport(CFrame.new(preLootSpot + Vector3.new(0, 15, 0)))
                end
            end

            -- Stop combat systems
            Farm.stopCurrent()
            Webhook.send("💀 Boss Killed", "**" .. bossName .. "** has been defeated!", 3066993)
            
            -- Loot collection: set flag to prevent anchor from repositioning us
            local shouldAutoLoot = (config.lootSpot or State.lastBossPosition) and (BossFarm.Settings.AutoLootOnKill or BossFarm.Settings.BossLoopEnabled)
            if shouldAutoLoot then
                State.isLooting = true
                Utils.setMode("looting")
                Utils.log("Boss died, teleporting to loot spot for " .. bossName)
                
                -- Dynamic LootSpot Fallback (For Tairock & unconfigured bosses)
                local lootCfg = config
                if not config.lootSpot then
                    lootCfg = {}
                    for k, v in pairs(config) do lootCfg[k] = v end
                    lootCfg.lootSpot = State.lastBossPosition
                end
                
                Loot.collectNearBoss(bossName, lootCfg)
                State.isLooting = false
                if State.running and not State.hideState.active then
                    Utils.setMode("idle")
                end
            end
            break
        end
        
        -- Health threshold check — wait for full regen before continuing
        if cPData.humanoid.Health < State.healthThreshold then
            if State.deathCheckInProgress or cPData.humanoid.Health <= 0 then
                Utils.recordEvent("Regen Skipped", "death check active")
                task.wait(0.05)
                continue
            end

            Utils.notify("Health low! Retreating to regen...", 3)
            Farm.stopCurrent()
            Utils.setMode("regen")
            
            local safeSpot = Safety.getSafeSpot() or SECRET_SPOT 
            local pd = Utils.getPlayerData()
            if pd then Utils.safeTeleport(CFrame.new(safeSpot)) end
            Utils.recordEvent("Regen Start", bossName .. " -> " .. Utils.formatVector3(safeSpot))
            
            -- Wait until HP is back to 100% (or farm is stopped)
            Utils.log("Waiting for HP to regen to 100%...")
            while State.running do
                local regenData = Utils.getPlayerData()
                if not regenData then break end
                if State.deathCheckInProgress or regenData.humanoid.Health <= 0 then
                    Utils.recordEvent("Regen Abort", "death check active")
                    break
                end

                local cache = State.threatCache or {}
                local hasThreat = cache.senseActive or cache.nearby
                local rootPos = regenData.rootPart.Position
                local horizontalDist = Vector3.new(rootPos.X - safeSpot.X, 0, rootPos.Z - safeSpot.Z).Magnitude
                local verticalDelta = rootPos.Y - safeSpot.Y

                if hasThreat then
                    if horizontalDist > 12 or math.abs(verticalDelta) > 8 then
                        Utils.recordEvent("Regen Threat Release", string.format("sense=%s nearby=%s h=%.1f y=%.1f",
                            tostring(cache.sensePlayer or "None"),
                            tostring(cache.nearbyPlayer or "None"),
                            horizontalDist,
                            verticalDelta
                        ))
                    end
                else
                    if horizontalDist > 2 or math.abs(verticalDelta) > 2 then
                        Utils.recordEvent("Regen Hold", string.format("h=%.1f y=%.1f", horizontalDist, verticalDelta))
                    end
                    Positioning.applyCFrame(regenData.rootPart, CFrame.new(safeSpot))
                end
                
                if regenData.humanoid.Health >= regenData.humanoid.MaxHealth then
                    Utils.log("HP fully regenerated!")
                    Utils.notify("HP full! Resuming fight...", 2)
                    break
                end
                
                task.wait(0.05)
            end
            
            -- After regen, DON'T break — re-enter the loop to re-engage the SAME boss
            -- We need to re-find the boss since we cleared state
            if State.running and not State.deathCheckInProgress then
                local reHum, reModel = Detection.findBoss(bossName)
                if reHum and reModel then
                    -- Re-setup everything for this boss
                    State.currentBoss = bossName
                    State.currentModel = reModel
                    State.currentHumanoid = reHum
                    State.bossDeathDetected = false
                    hum = reHum
                    model = reModel
                    
                    local newPData = Utils.getPlayerData()
                    if newPData then
                        State.healthThreshold = newPData.humanoid.MaxHealth * 0.5
                    end
                    
                    Weapons.updateBoost()
                    AnimMonitors.setup(model, bossName, config)
                    Positioning.primeCombatOffsets(model, config)
                    Knocked.monitor(model)
                    task.wait(0.5)
                    Charging.start()
                    Combat.enableNoclip()
                    Positioning.startAnchoring(model, config)
                    Combat.startAttacking(model)
                    Utils.setMode("engaging")
                    Utils.notify("Re-engaging: " .. bossName, 2)
                else
                    Utils.notify(bossName .. " despawned during regen.", 2)
                    break
                end
            else
                break
            end
            
            -- Continue the while loop to keep fighting
            continue
        end
        
        task.wait(BossFarm.Settings.HealthCheckInterval)
    end
end

function Farm.stopCurrent()
    -- Stop attack + positioning
    Charging.stop()
    if State.anchorConn then State.anchorConn:Disconnect(); State.anchorConn = nil end
    if State.attackThread then pcall(task.cancel, State.attackThread); State.attackThread = nil end
    if State.knockedThread then pcall(task.cancel, State.knockedThread); State.knockedThread = nil end
    -- Worker cleanup is split: combat threads stop here, threat workers live under Safety.stopWorkers().
    
    -- Reset per-boss state
    State.bossHeightBoost = 0
    State.hyugaArenaUnsafe = false
    State.hyugaArenaUnsafeSince = 0
    State.hyugaArenaTimeoutRequested = false
    State.hakuSafeSpot = false
    State.weaponHeightBoost = 0
    State.combatStabilizeUntil = 0
    State.bossDeathAttackUntil = 0
    State.bossDeathHoldCFrame = nil
    State.inDanger = false
    State.bossDeathDetected = false
    Safety.clearForcedPosition()
    -- Don't clear currentBoss here during looting — farmBoss checks it in the while loop
    if not State.isLooting then
        State.currentBoss = nil
        State.currentModel = nil
        State.currentHumanoid = nil
    end
    
    -- Disconnect all event connections and cancel threads
    Utils.disconnectAll()
    Utils.cancelAllThreads()
    if not State.hideState.active and State.mode ~= "hopping" then
        Utils.setMode("idle")
    end
end

-- ============================================
-- SINGLE BOSS FARM (Original behavior, upgraded)
-- ============================================
function Farm.start()
    if State.running then return end
    Safety.startWorkers()
    State.runId = State.runId + 1
    local currentRunId = State.runId
    State.farmThread = task.spawn(function()
        State.running = true
        State.evacuating = false
        State.serverHopInProgress = false
        if not State.hideState.active then
            Utils.setMode("idle")
        end
        Utils.notify("Boss auto-farm started!", 3)

        while BossFarm.Settings.Enabled and State.running and State.runId == currentRunId do
            Farm.stopCurrent()
            
            local hum, model, bossName = Detection.findAnySelectedBoss()
            
            if not hum then
                -- Try triggering spawns for selected bosses
                for name, isSelected in pairs(BossFarm.Settings.SelectedBosses) do
                    if isSelected then
                        local config = BOSS_CONFIGS[name]
                        if config and config.triggerSpawn then
                            Detection.triggerSpawnIfNeeded(name, config)
                            if not State.running then return end
                            hum, model = Detection.findBoss(name)
                            if hum and model then
                                bossName = name
                                break
                            end
                        end
                    end
                end
            end
            
            if not hum then
                if BossFarm.Settings.ServerHopIfNoBoss then
                    Utils.notify("No bosses found! Hopping...", 3)
                    task.wait(2)
                    ServerHop.execute()
                    break
                else
                    task.wait(2)
                    continue
                end
            end
            
            -- Check if boss is contested
            local contested, nearPlayer = Safety.isBossContested(model, BossFarm.Settings.PlayerDetectionRadius)
            if contested then
                Safety.evacuateAndHide("Players nearby! (" .. tostring(nearPlayer) .. ")")
                return
            end
            
            Farm.farmBoss(hum, model, bossName)
            task.wait(1)
        end
        
        State.running = false
        if State.farmThread and State.runId == currentRunId then
            State.farmThread = nil
        end
    end)
end

function Farm.stop()
    BossFarm.Settings.Enabled = false
    State.running = false
    Farm.stopCurrent()
    if State.farmThread then pcall(task.cancel, State.farmThread); State.farmThread = nil end
    Safety.stopWorkers()
    Utils.notify("Auto-farm stopped", 2)
end

-- ============================================
-- ADVANCED BOSS LOOP (Sequential multi-boss cycle)
-- ============================================
BossLoop = {}

function BossLoop.getSelectedList()
    local list = {}
    for bossName, enabled in pairs(BossFarm.Settings.SelectedBosses) do
        if enabled then table.insert(list, bossName) end
    end
    table.sort(list)
    return list
end

function BossLoop.start()
    if State.bossLoopThread then pcall(task.cancel, State.bossLoopThread) end
    BossFarm.Settings.BossLoopEnabled = true
    Safety.startWorkers()
    State.runId = State.runId + 1
    local currentRunId = State.runId
    State.running = true
    State.evacuating = false
    State.serverHopInProgress = false
    if not State.hideState.active then
        Utils.setMode("idle")
    end
    
    State.bossLoopThread = task.spawn(function()
        Utils.notify("Advanced Boss Loop started!", 3)

        while BossFarm.Settings.BossLoopEnabled and State.running and State.runId == currentRunId do
            local loopList = BossLoop.getSelectedList()
            
            if #loopList == 0 then
                Utils.notify("No bosses selected for loop!", 3)
                BossLoop.stop()
                break
            end
            
            -- Determine starting index (for resume after evacuate)
            local startIdx = 1
            if State.bossLoopIndex > 0 and State.bossLoopIndex <= #loopList then
                startIdx = State.bossLoopIndex
                Utils.log("Resuming boss loop from index " .. startIdx .. " (" .. loopList[startIdx] .. ")")
            end
            
            -- Iterate through each selected boss
            -- If resuming from middle, do startIdx..#list, then 1..startIdx-1 to complete full cycle
            local indicesToProcess = {}
            for i = startIdx, #loopList do
                table.insert(indicesToProcess, i)
            end
            if startIdx > 1 then
                -- Wrap around: farm the bosses we skipped at the beginning
                for i = 1, startIdx - 1 do
                    table.insert(indicesToProcess, i)
                end
            end
            
            local skippedCount = 0
            local totalProcessed = #indicesToProcess
            
            for _, i in ipairs(indicesToProcess) do
                if not BossFarm.Settings.BossLoopEnabled or not State.running then break end
                
                local bossName = loopList[i]
                State.bossLoopIndex = i  -- Track where we are in the loop
                
                local config = BOSS_CONFIGS[bossName]
                if not config then continue end
                
                -- Check chakra sense before even looking for the boss (server-wide danger)
                local senseActive, sensePlayer = Safety.isChakraSenseActive()
                if senseActive then
                    Safety.evacuateAndHide("Chakra Sense (" .. sensePlayer .. ") in loop")
                    return
                end
                
                -- Check if contested BEFORE spawning/finding
                -- For trigger-spawn bosses, check the trigger position
                if config.triggerSpawn and config.triggerPos then
                    local contested, nearPlayer = Safety.isPlayerNearPosition(config.triggerPos, BossFarm.Settings.PlayerDetectionRadius)
                    if contested then
                        Utils.notify(bossName .. " area contested, skipping...", 2)
                        skippedCount = skippedCount + 1
                        continue
                    end
                end
                
                -- Wait for boss to spawn (trigger if needed)
                local hum, model
                if config.triggerSpawn then
                    hum, model = Detection.waitForBossSpawn(bossName, config, 16)
                else
                    hum, model = Detection.findBoss(bossName)
                end
                
                if not hum or not model then
                    Utils.notify(bossName .. " unavailable, skipping...", 2)
                    continue
                end
                
                -- Farm this boss (farmBoss will return "contested" if players are near)
                local result = Farm.farmBoss(hum, model, bossName)
                
                if result == "contested" then
                    skippedCount = skippedCount + 1
                    continue
                end
                
                -- Clear current boss state after farmBoss finishes (in case looting flag was set)
                State.currentBoss = nil
                State.currentModel = nil
                State.currentHumanoid = nil
                
                -- Give a moment before moving to next boss
                task.wait(2)
            end
            
            -- If ALL bosses were skipped due to players, hop server
            if skippedCount >= totalProcessed and totalProcessed > 0 then
                Safety.evacuateAndHop("All " .. skippedCount .. " bosses contested!")
                return
            end
            
            -- Full loop complete — reset index for next cycle
            State.bossLoopIndex = 0
            
            -- Auto sell at end of loop
            if BossFarm.Settings.AutoSellTrinkets or BossFarm.Settings.AutoSellGems or BossFarm.Settings.AutoSellFruits then
                Utils.log("Loop complete — running auto sell...")
                pcall(function()
                    local dataFunc = GetDataFunction()
                    if not dataFunc then return end
                    
                    local playerData = nil
                    pcall(function() playerData = dataFunc:InvokeServer("GetData") end)
                    if type(playerData) ~= "table" then return end

                    local VillageData, villageMonth, villageWeek
                    pcall(function()
                        VillageData, villageMonth, villageWeek = dataFunc:InvokeServer("getVillageData")
                    end)

                    local function getVillageData(p83)
                        if not VillageData or not villageMonth or not villageWeek then return nil end
                        local mStr, wStr = "Month" .. tostring(villageMonth), "Week" .. tostring(villageWeek)
                        if not VillageData[mStr] or not VillageData[mStr][wStr] then return nil end
                        return VillageData[mStr][wStr][p83]
                    end

                    local function getEconomy(p88)
                        if p88 == "Rogue" then return "Struggling" end
                        if p88 == "Neutral" or not p88 then return "Average" end
                        local vData = getVillageData(p88)
                        return vData and vData.Politics.Economy or "Average"
                    end

                    local function getVillageRelationship(p89, p90)
                        if not p89 or not p90 then return nil end
                        if p89 == "Rogue" or p90 == "Rogue" then return "War" end
                        if p89 == "Neutral" or p90 == "Neutral" then return "Neutral" end
                        local v91, v92 = getVillageData(p89), getVillageData(p90)
                        if not v91 or not v92 then return "Neutral" end
                        if p89 == p90 then return "Own" end
                        if table.find(v91.Politics.Alliances, p90) or table.find(v92.Politics.Alliances, p89) then return "Allied" end
                        if table.find(v91.Politics.Wars, p90) or table.find(v92.Politics.Wars, p89) then return "War" end
                        return "Neutral"
                    end
                    
                    local function getModifiedPrice(basePrice, rel, econ, mode)
                        if not rel or not econ or type(basePrice) ~= "number" then return basePrice end
                        local modifier = PRICE_MODIFIERS[rel] and PRICE_MODIFIERS[rel][econ] and PRICE_MODIFIERS[rel][econ][mode] or 1
                        return math.max(1, math.floor(basePrice * modifier))
                    end

                    local targetVillage = "Neutral"
                    local relationship = getVillageRelationship(playerData.Village, targetVillage)
                    local economy = getEconomy(targetVillage)
                    
                    -- Native calculateBulk replacement
                    local trinketValue = 0
                    local gemValue = 0
                    local fruitCount = 0
                    local fruitSlots = {}
                    
                    local function countItems(tbl)
                        if type(tbl) ~= "table" then return end
                        for slotId, slot in pairs(tbl) do
                            if type(slot) == "table" and slot.Item then
                                local qty = tonumber(slot.Quantity) or 1
                                if TRINKET_VALUES[slot.Item] then
                                    trinketValue = trinketValue + (TRINKET_VALUES[slot.Item] * qty)
                                elseif GemSet[slot.Item] then
                                    gemValue = gemValue + (10 * qty)
                                elseif FRUIT_VALUES[slot.Item] or string.match(slot.Item, "Apple") or string.match(slot.Item, "Banana") then
                                    fruitCount = fruitCount + qty
                                    table.insert(fruitSlots, {id = slotId, qty = qty, price = FRUIT_VALUES[slot.Item] or 2})
                                end
                            end
                        end
                    end
                    
                    countItems(playerData.Inventory)
                    countItems(playerData.Loadout)
                    
                    if BossFarm.Settings.AutoSellTrinkets and trinketValue > 0 then
                        local modPrice = getModifiedPrice(trinketValue, relationship, economy, "Sell")
                        pcall(function() dataFunc:InvokeServer("SellingBulk", modPrice, "Trinket", nil, nil) end)
                        Utils.notify("💰 Auto-sold trinkets (" .. modPrice .. " Ryo)", 3)
                    end
                    
                    if BossFarm.Settings.AutoSellGems and gemValue > 0 then
                        local modPrice = getModifiedPrice(gemValue, relationship, economy, "Sell")
                        pcall(function() dataFunc:InvokeServer("SellingBulk", modPrice, "Gem", nil, nil) end)
                        Utils.notify("💎 Auto-sold gems (" .. modPrice .. " Ryo)", 3)
                    end
                    
                    if BossFarm.Settings.AutoSellFruits and fruitCount >= 99 then
                        local totalEarned = 0
                        for _, fruit in ipairs(fruitSlots) do
                            local rawPrice = fruit.price * fruit.qty
                            if rawPrice > 0 then
                                local modPrice = getModifiedPrice(rawPrice, relationship, economy, "Sell")
                                pcall(function() dataFunc:InvokeServer("SellFood", fruit.id, modPrice, nil, nil) end)
                                totalEarned = totalEarned + modPrice
                                task.wait(0.2)
                            end
                        end
                        if totalEarned > 0 then
                            Utils.notify("🍎 Auto-sold max fruits (" .. totalEarned .. " Ryo)", 3)
                        end
                    end
                end)
                task.wait(1)
            end
            
            -- Full loop complete
            if BossFarm.Settings.BossLoopEnabled and BossFarm.Settings.HopAfterLoop then
                Safety.evacuateAndHop("Loop complete")
                return
            end
            
            task.wait(2)
        end
        
        State.running = false
        if State.bossLoopThread and State.runId == currentRunId then
            State.bossLoopThread = nil
        end
    end)
end

function BossLoop.stop()
    BossFarm.Settings.BossLoopEnabled = false
    State.running = false
    Farm.stopCurrent()
    if State.bossLoopThread then pcall(task.cancel, State.bossLoopThread); State.bossLoopThread = nil end
    Safety.stopWorkers()
    Utils.notify("Boss loop stopped", 2)
end

