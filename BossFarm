-- ============================================
-- POSITIONING (Heartbeat anchor)
-- ============================================
local Positioning = {}

function Positioning.startAnchoring(model, config)
    State.anchorConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            -- ABSOLUTE SAFETY: if evacuating, do NOTHING
            if State.evacuating then return end
            if not State.running then return end
            
            -- If we're currently looting, don't reposition
            if State.isLooting then return end
            
            local hum = model:FindFirstChildOfClass("Humanoid")
            if not hum or not hum.Parent or hum.Health <= 0 then
                -- Don't call Farm.stopCurrent() here — just flag and let farmBoss handle it
                State.bossDeathDetected = true
                return
            end
            
            local bossRoot = Utils.getBossRoot(model)
            if not bossRoot then return end
            State.lastBossPosition = bossRoot.Position
            
            local pData = Utils.getPlayerData()
            if not pData then return end
            
            -- Haku safe spot timer check
            if State.hakuSafeSpot and tick() >= State.hakuSafeSpotEndTime then
                State.hakuSafeSpot = false
            end
            
            -- Position logic
            if State.hyugaInVoid then
                pData.rootPart.CFrame = CFrame.new(HYUGA_VOID_SAFE_SPOT)
            elseif State.hakuSafeSpot then
                pData.rootPart.CFrame = CFrame.new(HAKU_SAFE_SPOT)
            else
                local totalHeight = (config.height or 15)
                    + State.bossHeightBoost
                    + State.weaponHeightBoost
                
                local yOffset = config.positionAbove and totalHeight or -totalHeight
                
                pData.rootPart.CFrame = CFrame.lookAt(
                    bossRoot.Position + Vector3.new(0, yOffset, 0),
                    bossRoot.Position
                )
                
                -- Anti-Snipe System (spawn invisible platform beneath feet to reset fall duration flag)
                local now = tick()
                if not State.lastGroundTouch then State.lastGroundTouch = now end
                if now - State.lastGroundTouch > 11 then
                    if not State.antiSnipePart then
                        State.antiSnipePart = Instance.new("Part")
                        State.antiSnipePart.Size = Vector3.new(4, 3, 4)
                        State.antiSnipePart.Anchored = true
                        State.antiSnipePart.CanCollide = true
                        State.antiSnipePart.Transparency = 1
                        State.antiSnipePart.Parent = workspace
                    end
                    State.antiSnipePart.CFrame = pData.rootPart.CFrame * CFrame.new(0, -3.2, 0)
                    
                    if now - State.lastGroundTouch > 11.5 then
                        State.lastGroundTouch = now
                        if State.antiSnipePart then
                            pcall(function() State.antiSnipePart:Destroy() end)
                            State.antiSnipePart = nil
                        end
                    end
                end
            end
        end)
    end)
    Utils.addConnection(State.anchorConn)
end

-- ============================================
-- HTTP SERVER HOP SYSTEM
-- ============================================
ServerHop = {}

function ServerHop.join(serverId)
    local dataEvent = GetDataEvent()
    if dataEvent then
        Utils.log("Firing ServerTeleport to: " .. tostring(serverId))
        -- Write hop marker so CoreManager knows this is a redirect on next join
        pcall(function() writefile("PuppyHub_HopMarker.txt", tostring(tick())) end)
        dataEvent:FireServer("ServerTeleport", serverId, 14)
    else
        Utils.log("Error: DataEvent not found!", "warn")
    end
end

function ServerHop.fetchServers()
    local allServers = {}
    local success, response = pcall(function()
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        local url = string.format("https://roproxy-production-0200.up.railway.app/games/v1/games/%d/servers/0?sortOrder=2&excludeFullGames=false&limit=100", GAME_ID)
        if requestFunc then
            return requestFunc({Url = url, Method = "GET"}).Body
        else
            return game:HttpGet(url)
        end
    end)
    
    if not success or not response then return allServers end
    
    local jsonSuccess, data = pcall(HttpService.JSONDecode, HttpService, response)
    if not jsonSuccess or not data or not data.data then return allServers end
    
    for _, s in ipairs(data.data) do table.insert(allServers, s) end
    return allServers
end

function ServerHop.execute(keepTrying)
    Utils.log("Initiating HTTP server hop...")
    task.spawn(function()
        local function doHop()
            local servers = ServerHop.fetchServers()
            if #servers > 0 then
                local candidates = {}
                for _, s in ipairs(servers) do
                    if s.playing and s.maxPlayers and s.id ~= game.JobId then
                        if s.playing >= 5 and s.playing < (s.maxPlayers - 2) then
                            table.insert(candidates, s)
                        end
                    end
                end
                
                if #candidates > 0 then
                    local target = candidates[math.random(1, #candidates)]
                    Utils.log("Joining server: " .. target.id)
                    Utils.notify("Joining server...", 3)
                    Webhook.send("🔄 Server Hop", "Hopping to server: `" .. target.id .. "` (" .. target.playing .. " players)", 3447003)
                    ServerHop.join(target.id)
                else
                    Utils.log("No suitable servers found.")
                end
            end
        end
        
        if keepTrying then
            while true do
                doHop()
                task.wait(6)
            end
        else
            doHop()
        end
    end)
end

